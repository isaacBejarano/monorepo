# https://editorconfig.org/

# ANGULAR

# config file prioritary
root = true

# common

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# lang
[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false
